{
  "name": "dsh-feishucard",
  "version": "0.8.45",
  "engines": {
    "node": ">=22.15.0"
  },
  "description": "Feishu / Lark bridge for DeepSeek Harness (dsh, deepseek-harness) with a streaming-card reply: official-SDK long connection (no public URL), many bots in one instance, per-chat agent sessions, /new /switch /list /help /model commands, collapsible tool-call panels, approval cards, rate-limit backoff and plain-text fallback.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmfok/dsh-feishucard.git"
  },
  "homepage": "https://github.com/cmfok/dsh-feishucard",
  "bugs": {
    "url": "https://github.com/cmfok/dsh-feishucard/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./helper": "./helper.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "evalchat-route.mjs",
    "identity-inject.mjs",
    "heal-handoff.mjs",
    "g3-inbox-report.mjs",
    "helper.cjs",
    "cordis.patch.yml",
    "feishu.config.example.json",
    "identity_map.example.json",
    "scripts/collect_bot_roster.mjs",
    "README.md",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check helper.cjs",
    "smoke": "node scripts/smoke.mjs",
    "scrub": "node scripts/pre-publish-scrub.mjs",
    "sync": "node scripts/sync-to-profile.mjs",
    "smoke:quick": "node scripts/smoke.mjs --quick",
    "smoke:list": "node scripts/smoke.mjs --list"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.74.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "feishu",
    "lark",
    "cordis",
    "bot",
    "streaming-card"
  ],
  "license": "MIT"
}
